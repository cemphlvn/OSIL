(* OSIL grammar — v0.6
   v0.6 (G15, ratified 2026-08-13 per staged gate row + ADR-0010): stage-
   composition term language — `stage` declarations (runs/reads/writes
   resource footprint) and `then` composition in equivalences (CONTEXTUAL
   keyword, no new operator token; `.` stays univocal as namespace path).
   Boundary: R007 (stage-in-flow), R008 (compose mixed with arithmetic).
   Two document kinds (ADR-0005): .osil = architecture document (vocabulary),
   .flow = flow document (composition). Kind is selected by file extension.
   Backed by tools/osil_check.py: every corpus file must parse, every
   production must be exemplified by >=1 corpus file.
   v0.2 (G2, ratified 2026-08-12): actor/policy constructs added — GAP-1
   closed; conformance test #0 (profiles/domain/agent/repo-policy.osil) now
   PASSES. Juxtaposition rule ratified in the same change (closes GAP-3):
   path components and quantity number+unit must be ADJACENT (no whitespace).
   v0.3 (G4, working decisions delegated 2026-08-12): layout block added to
   flow documents — the visual identity projection's data. Working decisions
   D1 (coordinates: top-left origin, +y down, abstract px) and D2 (edge layout
   anchors by src -> dst pair) are OPEN DISCUSSIONS: see
   conformance/golden-render/README.md.
   v0.4 (G6, ratified 2026-08-12): multi-output edges `-> (Y, Z)` — GAP-4
   closed via the XPASS ritual on corpus 018; D3 syntax ratified as
   POSITIONAL outputs.
   v0.5 (G9, ratified 2026-08-12): dotted path components (spec/TERMS.md) —
   GAP-5 closed via the ritual on corpus 022; actor scopes may be
   file-granular, and the self-hosted policy narrows to what skills declare. *)

(* ==== document kinds ====================================================== *)
osil_document   = { osil_declaration } ;
flow_document   = { flow_statement } ;

osil_declaration = profile_decl
                 | projection_decl
                 | equivalence_decl
                 | model_decl
                 | invariant_decl
                 | operator_decl
                 | contract_decl
                 | concept_decl
                 | actor_decl
                 | stage_decl ;

flow_statement  = use_decl | io_decl | edge_stmt | layout_block ;

(* -- vocabulary: pin an ecosystem's versioned identity --------------------- *)
profile_decl    = "profile" , qualified_id , "{" , { profile_field } , "}" ;
profile_field   = identifier , "=" , literal
                | identifier , string , "=" , literal ;   (* opset "ai.onnx" = 24 *)

(* -- projections: transformation into a sovereign ecosystem ---------------- *)
projection_decl = "projection" , identifier , "{" ,
                    "from" , identifier ,
                    "preserve" , id_list ,
                  "}" ;

(* -- equivalences: semantic equality rules (egg-projectable) --------------- *)
equivalence_decl = "equivalence" , identifier , "{" ,
                     ( compose_expr , "<=>" , compose_expr
                     | expr , "<=>" , expr ) ,
                     [ guards_block ] ,
                   "}" ;
guards_block    = "guards" , "{" , { identifier , "=" , literal } , "}" ;

(* -- stages: the toolchain as vocabulary (G15, ADR-0010) -------------------- *)
stage_decl      = "stage" , identifier , "{" ,
                    [ "runs" , "=" , qualified_id ] ,
                    { resource_block } ,
                  "}" ;
resource_block  = ( "reads" | "writes" ) , "{" , { qualified_id } , "}" ;
(* sequential composition — CONTEXTUAL keyword `then`; operands are
   identifiers only (a declared stage name = ground constant, anything else
   = pattern variable — ADR-0010). Sorts do not mix: R008. *)
compose_expr    = identifier , "then" , identifier , { "then" , identifier } ;

(* -- models: intention + constraints (configuration compression) ----------- *)
model_decl      = "model" , identifier , "{" , { model_field } , "}" ;
model_field     = "purpose" , ":" , identifier
                | constraints_block
                | "ecosystem" , identifier ;
constraints_block = "constraints" , "{" , { constraint } , "}" ;
constraint      = identifier , rel_op , value ;

(* -- invariants & constrained operators ------------------------------------ *)
invariant_decl  = "invariant" , identifier ;
operator_decl   = "operator" , identifier , "{" , { operator_field } , "}" ;
operator_field  = "goal" , ":" , identifier
                | "preserves" , ":" , constraint
                | constraint ;

(* -- preservation contracts ------------------------------------------------- *)
contract_decl   = preserves_block , [ may_lose_block ] ;
preserves_block = "preserves" , "{" , id_list , "}" ;
may_lose_block  = "may_lose" , "{" , id_list , "}" ;

(* -- concepts: semantic identity with equivalence realizations -------------- *)
concept_decl    = "concept" , identifier , "{" ,
                    "equivalent_under" , "{" , arg_list , "}" ,
                    "to" , "{" , id_list , "}" ,
                  "}" ;

(* -- actors: operating policy as first-class vocabulary (GAP-1, closed at G2) *)
actor_decl      = "actor" , identifier , "{" , { actor_field } , "}" ;
actor_field     = scope_block | verbs_block | invariants_block | ratify_block ;
scope_block     = "scope" , "{" , path_list , "}" ;
verbs_block     = "verbs" , "{" , id_list , "}" ;
invariants_block = "invariants" , "{" , id_list , "}" ;
ratify_block    = "ratify" , "{" , id_list , "}" ;
path_list       = path_ref , { [ "," ] , path_ref } ;
path_ref        = path_component , { "/" , path_component } , [ "/" ] ;
path_component  = identifier , { "." , identifier } ;
                  (* everything ADJACENT (no whitespace); whitespace separates
                     sibling paths — same juxtaposition rule as quantity.
                     Dotted components (TERMS.md) since v0.5 / G9. *)

(* -- flow statements --------------------------------------------------------- *)
use_decl        = "use" , qualified_id ;
io_decl         = ( "input" | "const" | "output" ) , identifier , ":" , type ;
edge_stmt       = id_list , "->" , op_ref , "->" , out_spec ;
out_spec        = identifier
                | "(" , id_list , ")" ;     (* positional multi-output, D3/G6 *)
op_ref          = [ identifier , "::" ] , identifier , [ "@" , integer ] ;
type            = identifier , [ "<" , identifier , ">" ] ,
                  [ "[" , dim_list , "]" ] ;
dim_list        = dim , { "," , dim } ;
dim             = identifier | integer ;

(* -- layout: the visual identity projection's data (v0.3, gate G4) ----------
   Embedded in the SAME document as the semantics (BPMNDI lesson: separable,
   never decoupled) and in the SAME artifact class as the rest of the grammar
   (U4 rec 8). Anchoring is by stable identifier, never by position/order. *)
layout_block    = "layout" , "{" , { layout_stmt } , "}" ;
layout_stmt     = node_layout | edge_layout | label_layout | viewport_stmt ;
node_layout     = "node" , identifier , bounds ,
                  [ "collapsed" , "=" , boolean ] , [ "z" , "=" , integer ] ;
edge_layout     = "edge" , identifier , "->" , identifier ,
                  "waypoints" , "[" , point , { point } , "]" ;
label_layout    = "label" , identifier , bounds ;
viewport_stmt   = "viewport" , "[" , coord , "," , coord , "," , number , "]" ;
                  (* stored but NON-NORMATIVE: excluded from the golden gate *)
bounds          = "[" , coord , "," , coord , "," , number , "," , number , "]" ;
point           = "(" , coord , "," , coord , ")" ;
coord           = [ "-" ] , number ;

(* -- expressions (v0: enough for algebraic equivalences) -------------------- *)
expr            = term , { add_op , term } ;
term            = factor , { mul_op , factor } ;
factor          = identifier | number | "(" , expr , ")" ;
add_op          = "+" | "-" ;
mul_op          = "*" | "/" | "<<" | ">>" ;

(* -- lexical ------------------------------------------------------------------ *)
qualified_id    = identifier , { "." , identifier } ;
id_list         = identifier , { [ "," ] , identifier } ;
arg_list        = arg , { "," , arg } ;
arg             = identifier , [ "=" , literal ] ;
rel_op          = "<" | "<=" | ">" | ">=" | "=" | "==" ;
value           = literal | quantity ;
quantity        = number , identifier ;   (* 20ms, 2GB — number and unit ADJACENT
                                              (no whitespace); GAP-3 closed at G2 *)
literal         = number | string | identifier | boolean ;
boolean         = "true" | "false" ;
number          = integer | float ;
comment         = "//" , { any_char_to_eol } ;             (* line comments *)

(* NOTE on keywords: all keywords are CONTEXTUAL — a word like `equivalence`
   may appear as a plain identifier inside an id_list (see corpus 005). Parsers
   must match keywords by position, not reserve them globally. *)

(* NOTE on bindings (ADR-0008, G11 — GAP-2 closed WITHOUT grammar change):
   `:` is ROLE BINDING — closed grammar roles only (purpose, goal, preserves).
   `=` is ASSERTED EQUALITY — open keys to values; the block kind supplies the
   force (profile/guards/args/layout: stipulated; constraints: required).
   Rejection R006 pins the colon-misuse refusal. *)

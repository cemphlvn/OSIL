// profiles/domain/agent/repo-policy.oaas
// ============================================================================
// CONFORMANCE TEST #0: OAAS expresses its own repository's operating policy.
// "The first architecture OAAS describes is the OAAS repo."
//
// STATUS: PASSES since grammar v0.2 (gate G2 — GAP-1 closed, ratified by
// maintainer instruction 2026-08-12). This file carried the expected-fail marker from G0;
// during the closure sequence the XPASS guard fired and held the build red
// until this marker flip, exactly as designed (see docs/reports/g2-2026-08-12).
// ============================================================================

profile domain.agent {
    version = 0
}

actor spec-editor {
    scope { spec/ }
    verbs { draft refactor }
    invariants { univocity definitions_aristotelian }
    ratify { normative_must }              // humans ratify MUST-level changes
}

actor ecosystem-adapter {
    scope { profiles/ecosystem/ conformance/matrix/ }
    verbs { sync report }
    invariants { never_redefine_upstream }
}

actor corpus-gardener {
    scope { conformance/corpus/ }
    verbs { add refresh }
    invariants { every_example_parses no_deletion_without_ratification }
}

actor skill-improver {
    scope { improvable/ }
    verbs { edit_body }
    invariants { evals_pass changelog_logged frontmatter_constitutional }
}

// The merge gate, as an invariant over rewrites of the repository tree:
// a diff is legal iff  diff ⊆ scope(actor)  ∧  subtree invariants preserved.
invariant MergeLegality

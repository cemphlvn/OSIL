// profiles/domain/agent/repo-policy.oaas
// ============================================================================
// CONFORMANCE TEST #0: OAAS expresses its own repository's operating policy.
// "The first architecture OAAS describes is the OAAS repo."
//
// STATUS: PASSES since grammar v0.2 (G2). Extended at G8 to cover every
// deployed skill 1:1 — tools/policy_check.py mechanically verifies agreement
// between these actors and improvable/*/SKILL.md frontmatter (the standing
// loop GOVERNANCE.md promised). Since G9 (grammar v0.5, GAP-5 closed) scopes
// are FILE-GRANULAR where the skills declare them — narrowed from directory
// granularity, the constitutionally permitted automatic direction.
// ============================================================================

profile domain.agent {
    version = 3
}

// -- human role (no skill counterpart; policy_check exempts it) --------------
actor spec-editor {
    scope { spec/ }
    verbs { draft refactor }
    invariants { univocity definitions_aristotelian }
    ratify { normative_must }
}

// -- skill-bound actors: 1:1 with improvable/, frontmatter must agree --------
actor corpus-gardener {
    scope { conformance/corpus/ grammar/GAPS.md curriculum/paths/ }
    verbs { add refresh report }
    invariants { every_example_parses no_deletion_without_ratification }
}

actor univocity-lint {
    scope { spec/TERMS.md docs/reports/ }
    verbs { report propose }
    invariants { read_only_on_spec_prose findings_cite_line }
}

actor drift-watch {
    scope { profiles/ecosystem/ conformance/matrix/ }
    verbs { sync report }
    invariants { never_redefine_upstream stale_before_bump }
}

actor matrix-refresh {
    scope { conformance/matrix/ }
    verbs { refresh }
    invariants { never_fabricate_pass }
}

actor render-verify {
    scope { conformance/golden-render/ }
    verbs { add verify }
    invariants { zero_diff_gate goldens_ratified }
}

actor compression-scout {
    scope { conformance/compression/ docs/reports/ }
    verbs { measure report propose }
    invariants { rung_named_per_claim propose_only_on_vocabulary }
}

actor gate-reporter {
    scope { docs/reports/ }
    verbs { report }
    invariants { template_followed honesty_notes_required }
}

actor skill-improver {
    scope { improvable/ }
    verbs { edit-body propose-frontmatter }
    invariants { evals_pass changelog_logged frontmatter_constitutional }
}

// The merge gate, as an invariant over rewrites of the repository tree:
// a diff is legal iff  diff ⊆ scope(actor)  ∧  subtree invariants preserved.
invariant MergeLegality

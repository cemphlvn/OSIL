// profiles/domain/agent/toolchain.oaas
// Use case #2: the repo's own machinery described in OAAS (self-description
// bootstrap, docs/design/self-description-bootstrap.md). Vocabulary only;
// the pipelines live in conformance/corpus/ (016, 017, 019).

profile domain.toolchain {
    version = 0
}

invariant Deterministic
invariant ZeroDiff
invariant PixelDiffNeverGates

concept Validate {
    equivalent_under { grammar_version = 2 }
    to { oaas_check }
}

operator render {
    goal: deterministic_svg
    renderer_version == 1
    render_budget > 5ms
    fonts = "PinnedMono"
}

projection Identity {
    from OAAS-NATIVE
    preserve everything
}

preserves {
    semantics
    visual_layout
}

// -- flow-op vocabulary (G12): resolution found all 9 flow ops undeclared —
// the resolver's first catch. Each op the pipelines reference, now declared.
operator Parse { goal: corpus_to_ast }
operator Coverage { goal: production_coverage }
operator MakeModel { goal: case_to_model }
operator ExportFlow { goal: model_to_projection_image }
operator ImportModel { goal: projection_image_to_model }
operator Verify { goal: score_preservation }
operator ParseLayout { goal: flow_to_layout_data }
operator DataDiff { goal: layout_zero_diff }
operator RenderSVG { goal: deterministic_svg }

// provenance: G15 (ADR-0010) — the `just test` pipeline as declared
// vocabulary. Write-sets are FILE-granular resource ids; declarations are
// self-class truth (fidelity to tool source is declared, not yet extracted).
stage check {
    runs = tools.osil_check
    reads { conformance.corpus  profiles  grammar.osil_ebnf }
}

stage roundtrip {
    runs = tools.onnx_roundtrip
    reads { conformance.interop.onnx.cases  profiles.ecosystem.onnx.VERSIONS }
    writes { conformance.matrix.matrix_yaml  docs.reports.roundtrip_onnx_dated }
}

stage egraph {
    runs = tools.egraph_roundtrip
    reads { conformance.corpus  conformance.equivalence
            conformance.matrix.matrix_yaml  profiles.ecosystem.egglog.VERSIONS }
    writes { conformance.matrix.matrix_yaml  docs.reports.roundtrip_egraph_dated }
}

stage cproj {
    runs = tools.c_roundtrip
    reads { conformance.interop.c.cases  profiles.ecosystem.c.VERSIONS }
    writes { conformance.matrix.matrix_yaml  docs.reports.roundtrip_c_dated }
}

stage lift {
    runs = tools.lift_check
    reads { optimizer.probe.none60  conformance.lift.ground_truth }
    writes { conformance.lift.lifted_json }
}

stage choose {
    runs = tools.choose_check
    reads { optimizer.probe.none60  conformance.lift.ground_truth }
}

stage ceiling {
    runs = tools.ceiling_check
    reads { conformance.corpus  optimizer.probe.none60 }
}

stage harness {
    runs = tools.harness_check
    reads { tools  optimizer.probe.none60 }
}

stage render {
    runs = tools.render_check
    reads { conformance.corpus  conformance.golden-render }
}

stage policy {
    runs = tools.policy_check
    reads { improvable  profiles.domain.agent.repo-policy }
}

stage resolve {
    runs = tools.osil_resolve
    reads { conformance.corpus  conformance.resolution  profiles }
}

// the observer, observed: the commutation harness is itself a stage of the
// pipeline it models (agreement loop: justfile test-line == these decls, 1:1)
stage stages {
    runs = tools.stage_commute
    reads { conformance.corpus  conformance.equivalence  justfile }
    writes { docs.reports.stage_commute_dated }
}

// governed views (G16, ADR-0011): read-only on gate runs; blessing writes,
// and blessing is a ratification act outside the pipeline
stage views {
    runs = tools.view_render
    reads { conformance.corpus  profiles  conformance.matrix.matrix_yaml
            conformance.golden-render.views }
}

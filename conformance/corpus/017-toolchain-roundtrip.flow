// provenance: the repo's own G3 loop (tools/onnx_roundtrip.py) as a flow —
// self-description P1 (2026-08-12)
// normalized: ExportFlow's two products (text + passthrough) bundled as one
// `image` artifact — written pre-G6 when edges were single-output (GAP-4,
// closed 2026-08-12; see 018 for the ratified multi-output form). Bundled
// form retained as a valid historical fixture.
use domain.toolchain

input case : Generator<py>[1]
const contract : Contract<oaas>[1]
output score : Score<preservation>[1]

case -> toolchain::MakeModel@1 -> model
model -> toolchain::ExportFlow@1 -> image
image -> toolchain::ImportModel@1 -> rebuilt
model, rebuilt, contract -> toolchain::Verify@1 -> score

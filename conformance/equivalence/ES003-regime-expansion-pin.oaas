// PIN-ASSERT: regime = ExactArithmetic
// provenance: G14 adapter self-suite (2026-08-12); rule body mirrors corpus 003
equivalence distributivity_under_regime_name {
    (a * c) + (b * c)
    <=>
    (a + b) * c

    guards {
        numeric_semantics = exact
